# Copy to .env and fill in. Only DATABASE_URL and ACCESS_TOKEN_SECRET are required.

# --- required -----------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/course-platform
# at least 32 characters; generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ACCESS_TOKEN_SECRET=change-me-to-a-long-random-string-of-32-or-more-chars

# --- server -------------------------------------------------------------------
# development | production | test (production hides Swagger and DB error details)
NODE_ENV=development
PORT=3000
# comma-separated frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:5173
# set when running behind a proxy so rate limits see the client IP, e.g. 1 or loopback
# TRUST_PROXY=1
# defaults to on outside production
# SWAGGER_ENABLED=true

# --- uploads ------------------------------------------------------------------
UPLOAD_DIR=./uploads
# public base URL of uploaded files (defaults to http://localhost:$PORT/uploads)
# UPLOADS_BASE_URL=https://cdn.example.com/uploads

# --- database pool ------------------------------------------------------------
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=10000

# --- rate limits (per client IP unless noted) ---------------------------------
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
# login, register, refresh, logout, password change
THROTTLE_AUTH_LIMIT=10
# login attempts per username, then that username is blocked for the window
THROTTLE_LOGIN_USERNAME_LIMIT=5
THROTTLE_LOGIN_USERNAME_TTL_MS=900000

# --- first admin (only read by `npm run db:seed`) -----------------------------
# ADMIN_USERNAME=admin
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-please
