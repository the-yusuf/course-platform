# The server's .env for `docker compose`. On the server:
#   cp .env.production.example .env && nano .env
# Generate each secret with:  openssl rand -hex 32
# A value with a $ in it must be in single quotes, e.g. ADMIN_PASSWORD='pa$word':
# unquoted, Compose reads $word as a variable and silently drops it.

# --- database -----------------------------------------------------------------
POSTGRES_USER=course_platform
POSTGRES_DB=course_platform
# letters and digits only, because it goes inside the database URL
POSTGRES_PASSWORD=

# --- api ----------------------------------------------------------------------
ACCESS_TOKEN_SECRET=
# the frontend's address(es) on Vercel, comma-separated, no trailing slash
CORS_ORIGINS=https://your-project.vercel.app
# public address of uploaded images
UPLOADS_BASE_URL=https://dili-chinese.uz/uploads
# Folder on the server for the uploaded images, so nginx can serve them itself.
# Empty: they stay in a Docker volume and the API serves them. Create it once with:
#   sudo install -d -o 1000 -g 1000 -m 755 /srv/course-platform/uploads
UPLOADS_HOST_DIR=/srv/course-platform/uploads

# --- API docs (optional) ------------------------------------------------------
# true opens Swagger at https://dili-chinese.uz/api/docs behind a browser login.
# Both login values are then required; the password needs 12+ characters:
#   openssl rand -base64 18
SWAGGER_ENABLED=false
SWAGGER_USERNAME=
SWAGGER_PASSWORD=

# --- first admin (read only by `docker compose run --rm migrate npm run db:seed`)
# Delete these three values again after seeding.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
